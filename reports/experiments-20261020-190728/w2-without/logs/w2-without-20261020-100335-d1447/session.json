                "content": "import os\nimport glob\n\ndef find_peaks(wavelengths, intensities, height_threshold=0.2):\n    peaks = []\n    # Simple mean for baseline\n    mean_val = sum(intensities) / len(intensities)\n    \n    for i in range(1, len(intensities) - 1):\n        if intensities[i] > intensities[i-1] and intensities[i] > intensities[i+1]:\n            if intensities[i] > height_threshold:\n                peak_val = intensities[i]\n                half_max = (peak_val + mean_val) / 2\n                \n                left = i\n                while left > 0 and intensities[left] > half_max:\n                    left -= 1\n                \n                right = i\n                while right < len(intensities) - 1 and intensities[right] > half_max:\n                    right += 1\n                \n                width = wavelengths[right] - wavelengths[left]\n                peaks.append((wavelengths[i], width))\n    return peaks\n\ndata_dir = 'data'\nfiles = glob.glob(os.path.join(data_dir, 'spectrum_*.txt'))\n\nfor file in sorted(files):\n    print(f\"File: {file}\")\n    with open(file, 'r') as f:\n        lines = f.readlines()[1:] # skip header\n        data = [line.split() for line in lines]\n        wavelengths = [float(row[0]) for row in data]\n        intensities = [float(row[1]) for row in data]\n    \n    peaks = find_peaks(wavelengths, intensities)\n    if not peaks:\n        print(\"  No peaks found.\")\n    for pos, width in peaks:\n        print(f\"  Peak at {pos:.2f} nm, Width: {width:.2f} nm\")\n    print(\"-\" * 20)\n",
